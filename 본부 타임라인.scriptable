{
  "always_run_in_app": false,
  "icon": {
    "color": "deep-gray",
    "glyph": "bolt"
  },
  "name": "본부 타임라인",
  "script": "// Variables used by Scriptable.\n// These must be at the very top of the file. Do not edit.\n// icon-color: deep-gray; icon-glyph: bolt;\n/*\n * 본부 타임라인 — 아이폰 위젯 + 빠른 등록 (Scriptable 앱용)\n * - 홈 화면 위젯(작게·중간·크게)·잠금 화면 위젯: 오늘 내 일정 + 할 일\n * - 앱에서 실행 / 위젯의 ＋ 누르기: 한 줄 적으면 할 일(기본) 또는 🏢 본부 일정으로 등록\n * - 단축어(Siri·뒷면 탭·동작 버튼)에서 글을 넘기면 바로 할 일로 저장 (\"본부 \"로 시작하면 본부 일정)\n * 처음 한 번: 이름 고르기 → 회사 메일로 온 6자리 코드 입력 (열쇠는 아이폰 키체인에만 저장)\n */\nconst API = 'https://script.google.com/macros/s/AKfycbxsxzfHjXmoQWkNIyqG_OhYSDMxgXovBl60ptU2pWZEUfMKTYiYyN2neidU0IVhHqxk/exec';\nconst KEY = 'hq-timeline-key', NAME = 'hq-timeline-name';\nconst SELF = encodeURIComponent(Script.name());\nconst WD = ['일', '월', '화', '수', '목', '금', '토'];\nconst C = {\n  bg: Color.dynamic(new Color('#FFFFFF'), new Color('#1C1E21')), ink: Color.dynamic(new Color('#0B0B0B'), new Color('#F1F3F5')),\n  ink2: Color.dynamic(new Color('#4F545F'), new Color('#C1C5CC')), ink3: Color.dynamic(new Color('#868E96'), new Color('#8B929B')),\n  hq: new Color('#0066FF'), mt: new Color('#4C6EF5'), todo: new Color('#00B85C'), next: new Color('#FFD43B'), warn: new Color('#E03131'),\n};\n\n/* ── 서버 ── */\nasync function call(body) {\n  const r = new Request(API);\n  r.method = 'POST'; r.timeoutInterval = 25;\n  r.headers = { 'Content-Type': 'text/plain;charset=utf-8' };\n  r.body = JSON.stringify(body);\n  try { return await r.loadJSON(); } catch (e) { return { ok: false, code: 'NETWORK', message: '인터넷 연결을 확인해 주세요' }; }\n}\nconst key = () => (Keychain.contains(KEY) ? Keychain.get(KEY) : '');\nasync function api(body) {\n  const r = await call({ ...body, k: key() });\n  if (r && r.code === 'AUTH') { if (Keychain.contains(KEY)) Keychain.remove(KEY); }\n  return r;\n}\n\n/* ── 저장해 둔 피드 (위젯이 인터넷 없이도 보이게) ── */\nconst fm = FileManager.local(), cacheFile = fm.joinPath(fm.documentsDirectory(), 'hq-timeline-feed.json');\nfunction readCache() { try { return fm.fileExists(cacheFile) ? JSON.parse(fm.readString(cacheFile)) : null; } catch (e) { return null; } }\nfunction writeCache(f) { try { fm.writeString(cacheFile, JSON.stringify(f)); } catch (e) {} }\nasync function feed() { const r = await api({ a: 'feed', days: 7 }); if (r.ok) { writeCache(r); return r; } const c = readCache(); return c ? { ...c, stale: true, err: r } : { ok: false, err: r }; }\n\n/* ── 날짜 ── */\nconst todayIso = () => { const d = new Date(), p = v => String(v).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`; };\nconst md = iso => { const [y, m, d] = iso.split('-').map(Number); return `${m}/${d}(${WD[new Date(y, m - 1, d).getDay()]})`; };\nconst rel = iso => { const t = todayIso(); if (iso === t) return '오늘'; const n = Math.round((new Date(iso) - new Date(t)) / 864e5); return n === 1 ? '내일' : n === 2 ? '모레' : md(iso); };\nconst nowHm = () => new Date().toTimeString().slice(0, 5);\n\n/* ── 오늘 목록 만들기 (위젯·앱 공용) ── */\nfunction rowsOf(f) {\n  const t = f.today || todayIso(), now = nowHm();\n  const its = (f.items || []).filter(i => i.start <= t && i.end >= t).map(i => ({ kind: i.type === 'meeting' || i.type === 'interview' ? 'mt' : 'hq', t: i.timeStart || '', title: i.title + (i.place ? ' · ' + i.place : ''), done: i.status === '완료' }));\n  const rts = (f.routines || []).map(r => ({ kind: 'rt', t: r.timeStart || '', title: r.title }));\n  const todos = (f.todos || []).filter(x => !x.date || x.date <= t).map(x => ({ kind: 'todo', t: x.time || '', title: x.text, done: x.done, late: x.date && x.date < t }));\n  const sched = [...its, ...rts].sort((a, b) => (a.t || '~').localeCompare(b.t || '~'));\n  const next = sched.find(r => r.t && r.t >= now && !r.done);\n  return { sched, todos: todos.sort((a, b) => (a.done - b.done) || (a.t || '~').localeCompare(b.t || '~')), next, later: (f.todos || []).filter(x => x.date && x.date > t).length };\n}\n\n/* ── 위젯 ── */\nasync function widget() {\n  const fam = config.widgetFamily || 'medium', w = new ListWidget();\n  w.backgroundColor = C.bg; w.url = `scriptable:///run/${SELF}?action=menu`;\n  w.refreshAfterDate = new Date(Date.now() + 15 * 60000);\n  if (!key()) { w.setPadding(14, 14, 14, 14); const t = w.addText('본부 타임라인'); t.font = Font.boldSystemFont(14); t.textColor = C.ink; w.addSpacer(6); const s = w.addText('눌러서 연결해 주세요'); s.font = Font.systemFont(12); s.textColor = C.ink3; return w; }\n  const f = await feed();\n  if (!f.ok && !f.items) { const s = w.addText(f.err && f.err.message || '불러오지 못했어요'); s.font = Font.systemFont(12); s.textColor = C.ink3; return w; }\n  const R = rowsOf(f), [y, m, d] = (f.today || todayIso()).split('-').map(Number);\n\n  if (fam.startsWith('accessory')) { /* 잠금 화면 */\n    const n = R.next, open = R.todos.filter(x => !x.done).length;\n    if (fam === 'accessoryCircular') { const t = w.addText(String(open)); t.font = Font.boldSystemFont(20); t.centerAlignText(); const s = w.addText('할 일'); s.font = Font.systemFont(9); s.centerAlignText(); return w; }\n    const a = w.addText(n ? `${n.t} ${n.title}` : '남은 일정 없음'); a.font = Font.boldSystemFont(13); a.lineLimit = 1;\n    if (fam === 'accessoryRectangular') { const b = w.addText(`할 일 ${open}` + (R.sched.length ? ` · 일정 ${R.sched.length}` : '')); b.font = Font.systemFont(11); }\n    return w;\n  }\n\n  w.setPadding(12, 14, 10, 14);\n  const head = w.addStack(); head.centerAlignContent();\n  const h = head.addText(`${m}.${d} (${WD[new Date(y, m - 1, d).getDay()]})`); h.font = Font.boldSystemFont(fam === 'small' ? 13 : 14); h.textColor = C.ink;\n  head.addSpacer(6);\n  const cnt = head.addText(`일정 ${R.sched.length} · 할 일 ${R.todos.filter(x => !x.done).length}`); cnt.font = Font.systemFont(11); cnt.textColor = C.ink3; cnt.lineLimit = 1;\n  head.addSpacer();\n  const plus = head.addStack(); plus.url = `scriptable:///run/${SELF}?action=add`; plus.setPadding(1, 8, 1, 8); plus.cornerRadius = 9; plus.backgroundColor = C.ink;\n  const pt = plus.addText('＋'); pt.font = Font.boldSystemFont(13); pt.textColor = C.bg;\n  w.addSpacer(6);\n\n  const max = fam === 'small' ? 4 : fam === 'large' ? 13 : 5;\n  const list = [...R.sched.map(r => ({ ...r, isNext: r === R.next })), ...R.todos];\n  const show = list.slice(0, max);\n  if (!show.length) { const e = w.addText('오늘 남은 일정·할 일이 없어요'); e.font = Font.systemFont(12); e.textColor = C.ink3; }\n  show.forEach(r => {\n    const s = w.addStack(); s.centerAlignContent(); s.spacing = 6;\n    if (r.isNext) { s.backgroundColor = new Color('#FFD43B', 0.28); s.cornerRadius = 6; s.setPadding(1, 4, 1, 4); }\n    if (r.kind === 'todo') { const c = s.addText(r.done ? '✓' : '☐'); c.font = Font.boldSystemFont(12); c.textColor = r.done ? C.todo : C.ink3; }\n    else { const bar = s.addStack(); bar.size = new Size(3, 13); bar.cornerRadius = 1.5; bar.backgroundColor = r.kind === 'mt' ? C.mt : r.kind === 'rt' ? C.ink3 : C.hq; }\n    if (fam !== 'small' && (r.t || r.kind !== 'todo')) { const tt = s.addText(r.t || (r.kind === 'rt' ? '고정' : '하루')); tt.font = Font.mediumMonospacedSystemFont(11); tt.textColor = r.late ? C.warn : C.ink3; }\n    const tx = s.addText(r.title); tx.font = Font.systemFont(fam === 'small' ? 12 : 13); tx.textColor = r.done ? C.ink3 : C.ink; tx.lineLimit = 1;\n    w.addSpacer(fam === 'large' ? 4 : 3);\n  });\n  if (list.length > max) { const more = w.addText(`+${list.length - max}개 더`); more.font = Font.systemFont(11); more.textColor = C.ink3; }\n  w.addSpacer();\n  if (f.stale) { const st = w.addText('오프라인 · 마지막 저장본'); st.font = Font.systemFont(9); st.textColor = C.ink3; }\n  return w;\n}\n\n/* ── 연결 (처음 한 번) ── */\nasync function connect() {\n  const p = await call({ a: 'people' });\n  if (!p.ok) { await say('연결 창구에 닿지 못했어요', p.message || ''); return false; }\n  const pick = new Alert(); pick.title = '본부 타임라인 연결'; pick.message = '내 이름을 고르면 회사 메일로 6자리 코드가 가요';\n  p.people.forEach(n => pick.addAction(n)); pick.addCancelAction('취소');\n  const i = await pick.presentSheet(); if (i < 0) return false;\n  const name = p.people[i];\n  const s = await call({ a: 'codeStart', name });\n  if (!s.ok) { await say('코드를 보내지 못했어요', s.message); return false; }\n  for (let tries = 0; tries < 5; tries++) {\n    const a = new Alert(); a.title = '6자리 코드'; a.message = `${s.sentTo} 로 보냈어요 (10분 안에)`;\n    const tf = a.addTextField('000000'); tf.setNumberPadKeyboard();\n    a.addAction('연결'); a.addCancelAction('취소');\n    if ((await a.presentAlert()) < 0) return false;\n    const v = await call({ a: 'codeVerify', name, code: a.textFieldValue(0).trim(), device: '아이폰 · ' + Device.model() });\n    if (v.ok) { Keychain.set(KEY, v.key); Keychain.set(NAME, v.me.name); await say('연결됐어요', `${v.me.name}님, 이제 위젯을 홈 화면에 올려 보세요`); return true; }\n    await say('연결 실패', v.message);\n    if (v.code === 'CODE' && /만료|다시 받/.test(v.message)) return false;\n  }\n  return false;\n}\n\n/* ── 등록 ── */\nasync function add(text, mode) {\n  let t = String(text || '').trim();\n  if (!mode) mode = /^(본부|!)\\s*/.test(t) ? 'hq' : 'todo';\n  t = t.replace(/^(본부|!)\\s*/, '');\n  if (!t) return null;\n  const r = await api({ a: 'add', mode, text: t });\n  if (!r.ok) return { ok: false, msg: r.message || '저장 실패' };\n  if (r.kind === 'todo') return { ok: true, kind: 'todo', id: r.memo.id, msg: `✔ 「${r.memo.text}」` + (r.memo.date ? ` ${rel(r.memo.date)}${r.memo.time ? ' ' + r.memo.time : ''}` : '') + ' 할 일 추가' };\n  const x = r.record;\n  return { ok: true, kind: 'item', id: x.id, msg: `🏢 「${x.title}」 ${rel(x.start)}${x.timeStart ? ' ' + x.timeStart : ''} 본부 ${x.type === 'meeting' ? '회의' : '업무'}` + (r.notified ? ` · ${r.notified}명 알림` : '') };\n}\nasync function addDialog(mode, prev) {\n  const a = new Alert();\n  a.title = mode === 'hq' ? '🏢 본부 일정' : '✔ 할 일';\n  a.message = mode === 'hq' ? '예) 금요일 2시 주간 점검 @정재현 크리켓' : '예) 내일 3시 자료 정리 · 날짜 없이 써도 돼요';\n  a.addTextField(mode === 'hq' ? '일정 한 줄' : '할 일 한 줄', prev || '');\n  a.addAction(mode === 'hq' ? '본부에 등록' : '저장');\n  a.addAction(mode === 'hq' ? '✔ 할 일로 바꾸기' : '🏢 본부 일정으로 바꾸기');\n  a.addCancelAction('취소');\n  const i = await a.presentAlert(); if (i < 0) return;\n  const text = a.textFieldValue(0);\n  if (i === 1) return addDialog(mode === 'hq' ? 'todo' : 'hq', text); /* 적던 글 그대로 */\n  const r = await add(text, mode); if (!r) return;\n  if (!r.ok) return say('저장 못 했어요', r.msg);\n  const done = new Alert(); done.title = r.msg; done.addAction('확인'); done.addAction('되돌리기');\n  if ((await done.presentAlert()) === 1) { const u = await api({ a: 'undo', kind: r.kind, id: r.id }); await say(u.ok ? '되돌렸어요' : '되돌리기 실패', u.ok ? '' : u.message); }\n}\n\n/* ── 앱에서 열었을 때 ── */\nasync function menu() {\n  const f = await feed(), R = f.ok || f.items ? rowsOf(f) : null;\n  const a = new Alert();\n  a.title = '본부 타임라인' + (Keychain.contains(NAME) ? ' · ' + Keychain.get(NAME) : '');\n  a.message = R ? [...R.sched.map(r => `${r.t || (r.kind === 'rt' ? '고정' : '하루')}  ${r.title}`), ...R.todos.filter(x => !x.done).map(x => `☐ ${x.t ? x.t + ' ' : ''}${x.title}`)].join('\\n') || '오늘 남은 일정·할 일이 없어요' : (f.err && f.err.message) || '';\n  a.addAction('✔ 할 일 추가'); a.addAction('🏢 본부 일정 추가'); a.addAction('할 일 완료 처리'); a.addAction('사이트 열기'); a.addDestructiveAction('이 아이폰 연결 끊기'); a.addCancelAction('닫기');\n  const i = await a.presentSheet();\n  if (i === 0) await addDialog('todo');\n  else if (i === 1) await addDialog('hq');\n  else if (i === 2 && f.todos) {\n    const open = f.todos.filter(x => !x.done); if (!open.length) return say('남은 할 일이 없어요', '');\n    const p = new Alert(); p.title = '완료할 할 일'; open.forEach(x => p.addAction(x.text)); p.addCancelAction('닫기');\n    const j = await p.presentSheet(); if (j >= 0) { const r = await api({ a: 'done', id: open[j].id, done: true }); await say(r.ok ? '완료했어요' : '실패', r.ok ? open[j].text : r.message); }\n  } else if (i === 3 && f.site) Safari.open(f.site);\n  else if (i === 4) { await api({ a: 'revoke' }); if (Keychain.contains(KEY)) Keychain.remove(KEY); await say('연결을 끊었어요', '다시 쓰려면 다시 연결해 주세요'); }\n}\nasync function say(title, msg) { const a = new Alert(); a.title = title; a.message = msg || ''; a.addAction('확인'); await a.presentAlert(); }\n\n/* ── 시작 ── */\nasync function main() {\n  if (config.runsInWidget) { Script.setWidget(await widget()); return; }\n  const fromShortcut = (args.shortcutParameter || (args.plainTexts && args.plainTexts[0]) || '');\n  if (!key() && !config.runsWithSiri && !fromShortcut) { if (!(await connect())) return; }\n  if (fromShortcut) { /* 단축어·Siri: 받은 글을 바로 저장하고 결과를 돌려줌 */\n    if (!key()) { Script.setShortcutOutput('먼저 Scriptable 에서 「본부 타임라인」을 한 번 실행해 연결해 주세요'); return; }\n    const r = await add(fromShortcut); Script.setShortcutOutput(r ? r.msg : '내용이 비어 있어요'); return;\n  }\n  const qp = args.queryParameters || {};\n  if (/^[a-f0-9]{64}$/.test(qp.key || '')) { /* 홈 화면 앱(웹)에서 넘겨준 연결을 그대로 씀 — 메일 코드 다시 안 받아도 됨 */\n    const chk = await call({ a: 'feed', k: qp.key, days: 1 });\n    if (chk.ok) { Keychain.set(KEY, qp.key); Keychain.set(NAME, (chk.me && chk.me.name) || qp.name || ''); await say('위젯 연결 끝', '이제 홈 화면에 Scriptable 위젯을 놓고 「본부 타임라인」을 고르세요'); return; }\n    await say('연결 실패', chk.message || '');\n  }\n  const action = qp.action;\n  if (action === 'add') await addDialog('todo');\n  else if (action === 'preview') { const w = await widget(); await w.presentMedium(); } /* 위젯 미리보기 */\n  else await menu();\n}\nawait main();\nScript.complete();\n",
  "share_sheet_inputs": []
}